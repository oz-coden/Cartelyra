{
  "name": "cartelyra",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "sync:ui": "node scripts/shared-ui.mjs --update",
    "prebuild": "node scripts/shared-ui.mjs --check",
    "dev": "vite",
    "build": "npm run validate:data && tsc && vite build",
    "preview": "vite preview",
    "validate:data": "tsc -p tsconfig.tools.json && node scripts/validate-data.mjs",
    "audit:data": "tsc -p tsconfig.tools.json && node scripts/audit-data.mjs",
    "test": "tsc -p tsconfig.tools.json && node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@tweenjs/tween.js": "^23.1.3",
    "three": "^0.174.0"
  },
  "devDependencies": {
    "@types/three": "^0.174.0",
    "linkedom": "^0.18.13",
    "typescript": "^5.7.3",
    "vite": "^6.2.0"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "license": "SEE LICENSE IN LICENSE.md"
}
