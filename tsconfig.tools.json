  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "outDir": ".checks",
    "rootDir": "src"
  },
  "include": [
    "src/data/compile.ts",
    "src/data/validate.ts",
    "src/pathfinding/AStar.ts",
